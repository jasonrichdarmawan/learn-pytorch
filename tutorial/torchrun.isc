isc_project_id = "93fd04b1-f7e3-44d6-9a2d-b573740adeb2"
experiment_name = "torchrun"
gpu_type = "24GB VRAM GPU"
gpus = 16
output_path = "~/outputs/torchrun"
compute_mode = "cycle"
command = "source ~/.tutorial/bin/activate && cd ~/learn-pytorch/tutorial && torchrun --nnodes=$NNODES --nproc-per-node=$N_PROC --master_addr=$MASTER_ADDR --master_port=$MASTER_PORT --node_rank=$RANK torchrun.py"