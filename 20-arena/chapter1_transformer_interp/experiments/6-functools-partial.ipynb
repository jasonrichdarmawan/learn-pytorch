   "source": [
    "import functools\n",
    "\n",
    "def multiply(x, y):\n",
    "  \"\"\"Multiply two numbers.\"\"\"\n",
    "  return x * y\n",
    "\n",
    "# Create a new function that always multiplies by 2.\n",
    "double = functools.partial(multiply, 2)\n",
    "\n",
    "# Test the partial function.\n",
    "result = double(7)  # This computes 2 * 7.\n",
    "print(\"Double of 7 is\", result)"
   ]
  }
